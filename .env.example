# 복사해서 .env로 쓴다. 값은 커밋하지 않는다 (architecture.md 10장).
# 백엔드와 프론트엔드가 이 파일 하나를 함께 읽는다.

# --- 백엔드 ---
# asyncpg 접속 문자열. `docker compose up db`로 띄운 로컬 DB 기준
DATABASE_URL=postgresql+asyncpg://feynmi:feynmi@localhost:5432/feynmi
# 쉼표로 구분한 허용 오리진
CORS_ORIGINS=http://localhost:3000
# Firebase 프로젝트 ID. 프론트엔드의 NEXT_PUBLIC_FIREBASE_PROJECT_ID와 같은 값
FIREBASE_PROJECT_ID=
# 프로필 이미지와 탈퇴 시 파일 정리에 사용하는 비공개 버킷
GCS_BUCKET=
# ADC가 직접 서명할 수 없을 때 사용할 서비스 계정 이메일 (IAM signBlob 권한 필요)
GCS_SIGNER_SERVICE_ACCOUNT=

# AI 전용 설정/키는 .env.llm.example을 참고해 루트 .env.llm에 둔다.
# LLM 모듈은 .env → .env.llm → 프로세스 환경변수 순으로 덮어쓴다.
# 청크/검색 수치 (PRD 9.4)
RAG_CHUNK_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=100
RAG_TOP_K=5

# 이미지 글자 인식(OCR). 기본은 Tesseract, 결과가 애매할 때만 AI(.env.llm의 LLM_IMAGE_TEXT_MODEL)로 다시 읽는다.
# Tesseract 실행 파일 경로. PATH에 있으면 비워 둔다 (Windows 예: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
OCR_LANG=kor+eng
# 이보다 작은 그림(가로나 세로, 픽셀)은 아이콘으로 보고 읽지 않는다
OCR_MIN_IMAGE_SIDE=100
# 자료 하나에서 OCR할 그림 수 / AI로 다시 읽을 횟수 상한 (0이면 AI 보조 끔)
OCR_MAX_IMAGES=300
OCR_AI_MAX_CALLS=20
# "애매함" 기준: 단어 평균 신뢰도, 자신 없는 단어 비율(넘으면 한 번 더 읽기 / AI),
# 큰 그림 면적과 최소 글자 수, 알 수 없는 기호 비율
OCR_MIN_CONFIDENCE=60
OCR_MAX_WEAK_RATIO=0.3
OCR_RETRY_WEAK_RATIO=0.05
# 그림 한 장을 읽는 시간 상한(초)
OCR_TIMEOUT_SECONDS=60
OCR_LARGE_IMAGE_PIXELS=500000
OCR_MIN_CHARS_FOR_LARGE=10
OCR_MAX_GARBAGE_RATIO=0.3
OCR_MAX_ODD_TOKEN_RATIO=0.1
# 애매하고 평균 신뢰도가 이보다 낮으면(AI로 다시 읽지 못할 때) 그 그림의 글자를 버린다
OCR_DROP_BELOW_CONFIDENCE=40
# 그림 속 한 줄의 신뢰도가 이보다 낮고 한글이 절반 미만이면 그 줄만 버린다 (도표·아이콘의 엉터리 줄)
OCR_MIN_LINE_CONFIDENCE=35

# --- 프론트엔드 ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- compose (선택) ---
# 도커 데몬이 다른 파일시스템(Colima VM 등)에 있어 ./apps 경로가 컨테이너에 비어 보일 때, VM 기준 절대경로로 지정한다.
# BACKEND_SRC=/Users/me/Dev/Feynmi/apps/backend
# FRONTEND_SRC=/Users/me/Dev/Feynmi/apps/frontend
