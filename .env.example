# 복사해서 .env로 쓴다. 값은 커밋하지 않는다 (architecture.md 10장).
# 백엔드와 프론트엔드가 이 파일 하나를 함께 읽는다.

# --- 백엔드 ---
# asyncpg 접속 문자열. `docker compose up db`로 띄운 로컬 DB 기준
DATABASE_URL=postgresql+asyncpg://feynmi:feynmi@localhost:5432/feynmi
# 쉼표로 구분한 허용 오리진
CORS_ORIGINS=http://localhost:3000
# Firebase 프로젝트 ID. 프론트엔드의 NEXT_PUBLIC_FIREBASE_PROJECT_ID와 같은 값
FIREBASE_PROJECT_ID=

# --- 프론트엔드 ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_API_BASE_URL=

# --- compose (선택) ---
# 도커 데몬이 다른 파일시스템(Colima VM 등)에 있어 ./apps 경로가 컨테이너에 비어 보일 때, VM 기준 절대경로로 지정한다.
# BACKEND_SRC=/Users/me/Dev/Feynmi/apps/backend
# FRONTEND_SRC=/Users/me/Dev/Feynmi/apps/frontend
