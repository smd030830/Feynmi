# 전용 AI 설정. 저장소 루트의 .env.llm으로 복사한다 (Git 제외).
# OPENAI_API_KEY는 이 파일의 복사본에만 입력한다.
# 모델 ID/effort는 docs/prd.md 9.2를 참고해 환경변수로 지정한다.
OPENAI_API_KEY=
LLM_CONCEPT_EXTRACTION_MODEL=
LLM_CONCEPT_EXTRACTION_EFFORT=
LLM_ASSESSMENT_MODEL=
LLM_ASSESSMENT_EFFORT=
LLM_EMBEDDING_MODEL=
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
